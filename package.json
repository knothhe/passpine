{
  "name": "passpine-neo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd client && go run ./cmd/passpine",
    "preview": "cd client && go run ./cmd/passpine --preview",
    "build:client": "make client:build",
    "build:browser": "make browser:build",
    "build:browser:chrome": "make browser:build:chrome",
    "build:browser:firefox": "make browser:build:firefox",
    "build:browser:edge": "make browser:build:edge",
    "build": "make build",
    "install:local": "node scripts/install-local.mjs",
    "test:client": "cd client && go test -race ./...",
    "test:browser": "npm --prefix browser run typecheck && npm --prefix browser test",
    "test": "bash scripts/check.sh",
    "preview:browser": "npm --prefix browser run preview",
    "package:browser": "npm --prefix browser run zip"
  },
  "engines": {"node": ">=22.12.0"}
}
